{
  "name": "nex-campaign-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:rules": "vitest run tests/firestore.rules.test.ts",
    "test:functions": "vitest run functions/src/index.test.ts",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "firebase:emulators": "firebase emulators:start --only firestore,auth,functions --project demo-nex-campaign-app"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "firebase": "^13.2.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hot-toast": "^2.6.1",
    "react-router-dom": "^7.18.5",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
